# ── Backend API URL ───────────────────────────────────────────────────────────────
# In production on Vercel: set to your deployed Render backend URL
# (e.g. https://nutrivisionai-backend.onrender.com)
#
# In local development: leave blank or omit (Vite proxy forwards /api → http://localhost:5000)
VITE_API_BASE_URL=https://your-backend.onrender.com
