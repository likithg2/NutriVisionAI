# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Render, Neon, etc.)
# Supabase Transaction pooler example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional SSL toggle (defaults to true in production or when connection string contains sslmode=require / supabase / render / neon)
DB_SSL=true
# Optional path to Supabase / provider CA root certificate (enables rejectUnauthorized: true verification)
# Download from Supabase Project Settings -> Database -> SSL Certificate
# DB_CA_CERT_PATH=/etc/secrets/prod-ca-2021.crt

# ── Auth ─────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_characters

# ── CORS ─────────────────────────────────────────────────────────────────────────
# Deployed frontend URL(s). Comma-separated if multiple (e.g. Vercel preview & production)
FRONTEND_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ── AI APIs ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_API_KEY2=
OPENAI_API_KEY=
NEMOTRON_API_KEY=

# ── USDA Food Database ────────────────────────────────────────────────────────────
USDA_API_KEY=DEMO_KEY

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_VAPID_KEY=
WEB_PUSH_PRIVATE_VAPID_KEY=
WEB_PUSH_CONTACT=mailto:your@gmail.com

# ── Persistent Storage (Optional) ─────────────────────────────────────────────────
# Custom directory path for uploads if using a mounted persistent volume on Render
# UPLOADS_DIR=/var/data/uploads
